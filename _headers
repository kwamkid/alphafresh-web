# Cloudflare Pages — cache rules
# Long cache for assets that rarely change; short for HTML so edits go live fast.

/images/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

# Safe to cache for a year: build.py appends a content hash to every asset URL,
# so a changed file is always a new URL and never serves stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
