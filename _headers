# Cloudflare Pages — cache rules
# Long cache for assets that rarely change; short for HTML so edits go live fast.

/images/*
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
